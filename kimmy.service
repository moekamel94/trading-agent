[Unit]
Description=Kimmy Trading Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-agent
ExecStartPre=/usr/bin/git -C /root/trading-agent pull
ExecStart=/root/venv/bin/python3 -u main.py --discord
Restart=always
RestartSec=15

# Ensure UTF-8 output (prevents encoding crashes)
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=America/New_York

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kimmy

[Install]
WantedBy=multi-user.target
