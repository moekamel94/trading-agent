# Alpaca Paper Trading (get free keys at https://alpaca.markets)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Anthropic Claude API (get at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# newdata.io Financial News API (get at https://newdata.io)
NEWDATA_API_KEY=your_newdata_api_key

# Gmail — use an App Password, not your regular Gmail password
# Get one at: myaccount.google.com -> Security -> App passwords
EMAIL_ADDRESS=your@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
